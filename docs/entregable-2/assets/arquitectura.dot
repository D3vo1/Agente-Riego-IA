
digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.65];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#94A3B8", fillcolor="#F8FAFC", margin="0.14,0.09"];
