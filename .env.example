# Obtén tu clave en https://console.groq.com/keys
GROQ_API_KEY=gsk_reemplaza_esto_con_tu_clave

# Usa un modelo disponible en tu cuenta de Groq
GROQ_MODEL=openai/gpt-oss-20b

TEMPERATURE=0.2
MAX_HISTORY_MESSAGES=12
RAG_TOP_K=4
# Distancia coseno maxima (0-1) para usar un fragmento; mas baja = mas estricta
RAG_MAX_DISTANCE=0.95
# Conversaciones que se conservan en memoria a la vez
MAX_SESSIONS=500
VECTOR_DB_PATH=data/chroma
KNOWLEDGE_DIR=knowledge

# Microservicio Django/DRF
DJANGO_SERVICE_URL=http://127.0.0.1:8001
DJANGO_LOGGING_ENABLED=true
DJANGO_TIMEOUT_SECONDS=2.0
DJANGO_SECRET_KEY=cambia-esta-clave-local
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Clave compartida entre FastAPI y Django. Vacia = API de gestion abierta (solo local)
MANAGEMENT_API_KEY=
# Cada cuantos segundos FastAPI relee las reglas activadas en Django
RULES_REFRESH_SECONDS=60

