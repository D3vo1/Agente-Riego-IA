# Obtén tu clave en https://console.groq.com/keys
GROQ_API_KEY=gsk_reemplaza_esto_con_tu_clave

# Usa un modelo disponible en tu cuenta de Groq
GROQ_MODEL=openai/gpt-oss-20b

TEMPERATURE=0.2
MAX_HISTORY_MESSAGES=12
RAG_TOP_K=4
VECTOR_DB_PATH=data/chroma
KNOWLEDGE_DIR=knowledge

# Microservicio Django/DRF
DJANGO_SERVICE_URL=http://127.0.0.1:8001
DJANGO_LOGGING_ENABLED=true
DJANGO_TIMEOUT_SECONDS=2.0
DJANGO_SECRET_KEY=cambia-esta-clave-local

